#!/usr/bin/env bash
# Installs and configures HAProxy as a round-robin load balancer for web-01/web-02
apt-get update -y
apt-get install -y haproxy

# On Ubuntu 16.04, the init script only starts HAProxy if enabled here
if grep -q "^ENABLED=0" /etc/default/haproxy; then
	sed -i 's/^ENABLED=0/ENABLED=1/' /etc/default/haproxy
fi

if ! grep -q "^frontend http_front" /etc/haproxy/haproxy.cfg; then
	cat >> /etc/haproxy/haproxy.cfg << 'HAPROXY_EOF'

frontend http_front
	bind *:80
	default_backend http_back

backend http_back
	balance roundrobin
	server web-01 WEB01_IP_HERE:80 check
	server web-02 WEB02_IP_HERE:80 check
HAPROXY_EOF
fi

service haproxy restart
